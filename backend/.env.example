# TailorFit AI Backend — environment template
# Copy to .env and fill real secrets.

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Supabase (PostgreSQL + storage metadata)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Direct PostgreSQL DSN used by migration/seed tools (optional)
DATABASE_URL=postgresql://postgres:password@db.host.supabase.co:5432/postgres

# Object storage (AWS S3 or Cloudflare R2 — S3-compatible)
S3_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET=tailorfit-scans
S3_PUBLIC_BASE_URL=https://pub.your-domain.com

# ML model artifacts (HMR 2.0 / SMPL-X checkpoint)
SMPLX_MODEL_PATH=/models/smplx
HMR2_CHECKPOINT_PATH=/models/hmr2.pt
YOLO_SEG_WEIGHTS=yolov8n-seg.pt

# Local storage for queued uploads
UPLOAD_DIR=/srv/backend/storage/uploads

# API
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000